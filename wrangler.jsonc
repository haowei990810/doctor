{
  // Worker 名称：决定访问地址 https://<name>.<账户子域>.workers.dev 中的 <name>。
  // 这里用见名知意的 tick-bites（蜱虫叮咬）。
  "name": "tick-bites",
  "compatibility_date": "2025-06-05",

  // 纯静态站点（Vue SPA）：只把 Vite 构建产物 dist 目录作为静态资源发布，
  // 不需要 main / Worker 脚本。这样 `wrangler deploy` 就不会再去解析 vite.config.js。
  "assets": {
    "directory": "./dist",
    // 单页应用：任意未命中路径都回退到 index.html（history 模式也不会 404）
    "not_found_handling": "single-page-application"
  }

  // 👉 绑定自定义域名（去掉 haowei990810）：把域名托管到 Cloudflare 后，
  //    取消下面注释并把 你的域名 换成实际域名，再运行 `wrangler deploy` 即可。
  //    最终访问地址：https://tick-bites.你的域名
  // ,"routes": [
  //   { "pattern": "tick-bites.你的域名", "custom_domain": true }
  // ]
}
